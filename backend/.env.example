# Copy to .env — NEVER commit real values
DATABASE_URL=postgres://user:password@localhost:5432/fireroz
JWT_SECRET=change-me-long-random-string
PORT=4000
NODE_ENV=development
# SMS OTP provider (MSG91 / Twilio etc.) — fill when ready
SMS_PROVIDER=
SMS_API_KEY=
# Firebase Cloud Messaging service account JSON (path or base64)
FCM_SERVICE_ACCOUNT=
# Cloud storage for medical documents (S3 compatible)
STORAGE_BUCKET=
STORAGE_KEY=
STORAGE_SECRET=
